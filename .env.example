# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# --- live_feed_detect_face.c ---
# Project root (contains LVPython/ and live_feed_detect_face.py); defaults to the current directory
LV_HOME=.

# --- live_feed_detect_face.py ---
# Folder where captured/cropped face frames are written (defaults to ./face_detect next to the script)
SAVE_DIR=
# URL of the C inference service's trigger endpoint
C_TRIGGER_URL=http://localhost:6000/trigger
# Minimum seconds between triggers
TRIGGER_COOLDOWN_SECONDS=60
# Flask server bind address / port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- face_recognition_alarm.c ---
# Telegram bot credentials for alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTTP server port for the /trigger endpoint
HTTP_PORT=6000
# Paths to the face image, ONNX model, and reference embedding (defaults are relative to the working directory)
FACE_IMAGE_PATH=face_detect/detected_face_latest.jpg
MODEL_PATH=finetuned_model.onnx
REF_EMBEDDING_PATH=ref_embedding.txt
# Cosine-similarity threshold below which a face is considered unrecognized
SIMILARITY_THRESHOLD=0.35
