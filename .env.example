# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# --- live_feed_detect_face.py ---
# Folder where captured/cropped face frames are written (defaults to ./face_detect next to the script)
SAVE_DIR=
# URL of the C inference service's trigger endpoint
C_TRIGGER_URL=http://localhost:6000/trigger
# Minimum seconds between triggers
TRIGGER_COOLDOWN_SECONDS=60
# Flask server bind address / port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

